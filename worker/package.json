{
  "name": "money-tweaks-worker",
  "private": true,
  "description": "Money Tweaks website Worker: serves docs/ and the Community Hub API under /api/community/ (D1 + Cloudflare Images).",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config ../wrangler.jsonc --local",
    "test": "vitest run",
    "deploy": "wrangler deploy --config ../wrangler.jsonc",
    "check": "tsc --noEmit && vitest run && wrangler deploy --config ../wrangler.jsonc --dry-run --outdir .wrangler/dry",
    "typecheck": "tsc --noEmit",
    "migrate:local": "wrangler d1 migrations apply DB --local --config ../wrangler.jsonc",
    "migrate:remote": "wrangler d1 migrations apply DB --remote --config ../wrangler.jsonc"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20261006.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.148.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261006.1": true
  }
}
