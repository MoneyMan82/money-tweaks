// Cloudflare static site config: serves the docs/ folder. Used by `npx wrangler deploy`
// (Workers & Pages Git integration) and ignored by classic Pages projects.
{
  "name": "money-tweaks",
  "compatibility_date": "2025-09-01",
  // Publish on <name>.<account>.workers.dev (otherwise the dashboard shows "No URLs enabled").
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./docs"
  }
}
