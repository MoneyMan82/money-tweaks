<Project>
  <PropertyGroup>
    <Version>1.32.0</Version>
    <Product>Money Tweaks</Product>
    <Company>Money Tweaks</Company>
    <Authors>MoneyMan82</Authors>
    <Copyright>Copyright © 2026 Money Tweaks contributors. MIT License.</Copyright>
    <Description>Free, open-source Windows 10/11 performance and privacy tweaker.</Description>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WindowsTargetFramework>net10.0-windows10.0.19041.0</WindowsTargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>
</Project>
