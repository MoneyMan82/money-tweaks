<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(WindowsTargetFramework)</TargetFramework>
    <RootNamespace>MoneyTweaks.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.Management" Version="10.0.2" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MoneyTweaks.Community.Shared\MoneyTweaks.Community.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MoneyTweaks.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Pocket Panel's phone dashboard, served from memory (never from disk). -->
    <EmbeddedResource Include="Pocket/web/index.html" LogicalName="MoneyTweaks.Pocket.index.html" />
    <EmbeddedResource Include="Pocket/web/app.js" LogicalName="MoneyTweaks.Pocket.app.js" />
    <EmbeddedResource Include="Pocket/web/app.css" LogicalName="MoneyTweaks.Pocket.app.css" />
  </ItemGroup>
</Project>
