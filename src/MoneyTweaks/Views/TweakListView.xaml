<UserControl x:Class="MoneyTweaks.Views.TweakListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <DataTemplate x:Key="TweakTemplate">
            <Border x:Name="card" Style="{StaticResource CardBorder}" Margin="0,0,0,10" Padding="0" Cursor="Arrow">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- risk strip -->
                    <Border x:Name="strip" CornerRadius="0" Background="{StaticResource AccentGradient}" Opacity="0.85"/>
                    <StackPanel Grid.Column="1" Margin="18,14,8,14">
                        <WrapPanel>
                            <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Border x:Name="risk" Style="{StaticResource Badge}" Background="{StaticResource AccentSoft}">
                                <TextBlock x:Name="riskText" Text="{Binding RiskLabel}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                            </Border>
                            <Border x:Name="tier" Style="{StaticResource Badge}" Background="{StaticResource GoldSoft}" Visibility="{Binding ShowTier, Converter={StaticResource B2V}}" ToolTip="{Binding TierTip}">
                                <TextBlock x:Name="tierText" Text="{Binding TierLabel}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Gold}"/>
                            </Border>
                            <Border Style="{StaticResource Badge}" Background="#14FFFFFF" Visibility="{Binding NeedsAdmin, Converter={StaticResource B2V}}" ToolTip="Needs administrator rights">
                                <TextBlock Text="Admin" FontSize="10.5" Foreground="{StaticResource Muted}"/>
                            </Border>
                            <Border Style="{StaticResource Badge}" Background="#14FFFFFF" Visibility="{Binding NeedsReboot, Converter={StaticResource B2V}}" ToolTip="Takes full effect after a restart">
                                <TextBlock Text="Restart" FontSize="10.5" Foreground="{StaticResource Muted}"/>
                            </Border>
                            <Border Style="{StaticResource Badge}" Background="{StaticResource VioletSoft}" Visibility="{Binding IsRecommended, Converter={StaticResource B2V}}" ToolTip="Part of the Recommended preset">
                                <TextBlock Text="★ Recommended" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Violet}"/>
                            </Border>
                            <Border Style="{StaticResource Badge}" Background="#14FFFFFF" Visibility="{Binding IsGuide, Converter={StaticResource B2V}}">
                                <TextBlock Text="Guide" FontSize="10.5" Foreground="{StaticResource Muted}"/>
                            </Border>
                            <Border Style="{StaticResource Badge}" Background="{StaticResource GoldSoft}" Visibility="{Binding HasNotes, Converter={StaticResource B2V}}" ToolTip="{Binding NotesText}">
                                <TextBlock Text="{Binding NotesBadge}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Gold}"/>
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="0,6,0,0" MaxWidth="820" HorizontalAlignment="Left"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Border x:Name="status" CornerRadius="0" Padding="8,2" Background="#10FFFFFF" Margin="0,0,10,0">
                                <TextBlock x:Name="statusText" Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                            </Border>
                            <TextBlock Text="{Binding Message}" FontSize="11.5" Foreground="{StaticResource Gold}" TextWrapping="Wrap" MaxWidth="560" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ToggleButton x:Name="more" IsChecked="{Binding Expanded}" Cursor="Hand" VerticalAlignment="Center">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <TextBlock x:Name="t" Text="What changes ›" FontSize="11.5" Foreground="{StaticResource Subtle}" Background="Transparent"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="t" Property="Text" Value="Hide details ‹"/></Trigger>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="Foreground" Value="{StaticResource Accent}"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Button Content="Test" Style="{StaticResource GhostButton}" Padding="10,3" FontSize="11.5" Margin="12,0,0,0" VerticalAlignment="Center"
                                    Click="Test_Click" ToolTip="Read every setting back from Windows and check Undo is ready. Changes nothing."/>
                            <Button Content="Benchmark" Style="{StaticResource GhostButton}" Padding="10,3" FontSize="11.5" Margin="4,0,0,0" VerticalAlignment="Center"
                                    Click="Benchmark_Click" ToolTip="Measure before and after applying this tweak"/>
                            <Button Content="Undo" Style="{StaticResource GhostButton}" Padding="10,3" FontSize="11.5" Margin="4,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding CanUndo, Converter={StaticResource B2V}}" Click="Undo_Click"
                                    ToolTip="Roll back: restore the original values backed up when this tweak was applied, and read them back"/>
                        </WrapPanel>
                        <!-- Notes (limitations, conflicts) live with the details: the gold badge above shows they exist and previews them on hover. -->
                        <Border Visibility="{Binding Expanded, Converter={StaticResource B2V}}" IsVisibleChanged="Details_VisibleChanged" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="0" Padding="14,12" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding NotesText}" Visibility="{Binding HasNotes, Converter={StaticResource B2V}}" FontSize="11.5" Foreground="{StaticResource Gold}"
                                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding Details}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                                <!-- Related settings elsewhere in the library (conflicts first). Click opens the tweak where it lives. -->
                                <StackPanel Visibility="{Binding HasRelated, Converter={StaticResource B2V}}" Margin="0,12,0,0">
                                    <TextBlock Text="RELATED SETTINGS" Style="{StaticResource Eyebrow}" Margin="0,0,0,4"/>
                                    <ItemsControl ItemsSource="{Binding Related}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Click="Related_Click" Tag="{Binding Id}" Cursor="Hand" Margin="0,3,0,0" HorizontalContentAlignment="Stretch" ToolTip="Open this setting">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="B" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="0" Padding="10,6">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{StaticResource CardHover}"/></Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <StackPanel>
                                                        <WrapPanel>
                                                            <Border CornerRadius="0" Padding="6,1" Margin="0,0,8,0" Background="{Binding SoftBrush}" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="Bold" Foreground="{Binding ToneBrush}"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Where}" FontSize="11.5" Foreground="{StaticResource Subtle}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding Text}" FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <!-- Tweak Truth Index: measured evidence, estimate and community results (built when shown). -->
                                <ContentControl IsVisibleChanged="Evidence_VisibleChanged" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Grid Grid.Column="2" VerticalAlignment="Top" Margin="12,16,18,0">
                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding IsOn, Mode=OneWay}" IsEnabled="{Binding CanToggle}"
                                      IsThreeState="True" Click="Switch_Click" ToolTip="Apply / undo"/>
                    </Grid>
                    <!-- Hover: a violet rim and a faint wash fade in over the card (opacity only). -->
                    <Border x:Name="hl" Grid.ColumnSpan="3" Background="#06FFFFFF" BorderBrush="#4D8A6BFF" BorderThickness="1" Opacity="0" IsHitTestVisible="False"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hl" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.160"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                    <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hl" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.280"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
                </Trigger>
                <DataTrigger Binding="{Binding IsCaution}" Value="True">
                    <Setter TargetName="risk" Property="Background" Value="{StaticResource GoldSoft}"/>
                    <Setter TargetName="riskText" Property="Foreground" Value="{StaticResource Gold}"/>
                    <Setter TargetName="strip" Property="Background" Value="{StaticResource Gold}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsExperimental}" Value="True">
                    <Setter TargetName="tier" Property="Background" Value="{StaticResource DangerSoft}"/>
                    <Setter TargetName="tierText" Property="Foreground" Value="{StaticResource Danger}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Applied">
                    <Setter TargetName="status" Property="Background" Value="{StaticResource SuccessSoft}"/>
                    <Setter TargetName="statusText" Property="Foreground" Value="{StaticResource Success}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Partial">
                    <Setter TargetName="status" Property="Background" Value="{StaticResource GoldSoft}"/>
                    <Setter TargetName="statusText" Property="Foreground" Value="{StaticResource Gold}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="NotApplied">
                    <Setter TargetName="status" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="NotApplicable">
                    <Setter TargetName="card" Property="Opacity" Value="0.6"/>
                </DataTrigger>
                <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="card" Property="Background" Value="{StaticResource CardHover}"/>
                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource CardRimHover}"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,6,28,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <!-- Same icon tile as every page header (Ui.IconTile): dark glass, violet→cyan rim and glyph. -->
                <Border Width="46" Height="46" CornerRadius="0" BorderBrush="{StaticResource AccentGradient}" BorderThickness="1" VerticalAlignment="Top" Margin="0,2,16,0">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF1B1833" Offset="0"/><GradientStop Color="#FF0E161C" Offset="1"/></LinearGradientBrush></Border.Background>
                    <TextBlock x:Name="CatIcon" Style="{StaticResource Icon}" FontSize="19" Foreground="{StaticResource AccentGradient}" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel MaxWidth="640">
                    <TextBlock x:Name="EyebrowText" Text="TWEAK CATEGORY" Style="{StaticResource Eyebrow}"/>
                    <TextBlock x:Name="TitleText" Style="{StaticResource H1}"/>
                    <TextBlock x:Name="BlurbText" Style="{StaticResource MutedText}" FontSize="13.5" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="16,12" VerticalAlignment="Top" MinWidth="200" Margin="16,0,0,0">
                <StackPanel>
                    <TextBlock Text="APPLIED" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Muted}"/>
                    <TextBlock x:Name="AppliedBig" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" Text="–"/>
                    <ProgressBar x:Name="AppliedBar" Margin="0,8,0,0" Maximum="1"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Toolbar (opens with the signature rule, like every page header) -->
        <StackPanel Grid.Row="1" Margin="0,16,0,12">
            <Grid Height="2" Margin="0,0,0,16">
                <Border Height="1" Background="{StaticResource Hairline}" VerticalAlignment="Center"/>
                <Border Width="64" Height="2" CornerRadius="0" Background="{StaticResource AccentGradientH}" HorizontalAlignment="Left"/>
            </Grid>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RecommendedButton" Content="★  Apply recommended" Style="{StaticResource PrimaryButton}" Click="ApplyRecommended_Click" Margin="0,0,8,0"/>
                    <Button Content="Undo all" Click="UndoAll_Click"/>
                </StackPanel>
                <Grid Width="260" Margin="0,0,12,0" HorizontalAlignment="Left">
                    <TextBox x:Name="SearchBox" TextChanged="Filter_Changed" Padding="32,8,10,8" Tag="Search tweaks…"/>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Foreground="{StaticResource Muted}" Margin="12,0,0,0" IsHitTestVisible="False"/>
                </Grid>
                <WrapPanel VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource Chip}" Content="All" GroupName="f" IsChecked="True" Tag="all" Checked="Filter_Changed" Margin="0,0,6,4"/>
                    <RadioButton Style="{StaticResource Chip}" Content="Applied" GroupName="f" Tag="applied" Checked="Filter_Changed" Margin="0,0,6,4"/>
                    <RadioButton Style="{StaticResource Chip}" Content="Not applied" GroupName="f" Tag="off" Checked="Filter_Changed" Margin="0,0,6,4"/>
                    <RadioButton Style="{StaticResource Chip}" Content="Safe" GroupName="f" Tag="safe" Checked="Filter_Changed" Margin="0,0,6,4"/>
                    <RadioButton Style="{StaticResource Chip}" Content="Caution" GroupName="f" Tag="caution" Checked="Filter_Changed" Margin="0,0,6,4"/>
                    <RadioButton Style="{StaticResource Chip}" Content="Advanced" GroupName="f" Tag="tier-adv" Checked="Filter_Changed" Margin="0,0,6,4"
                                 ToolTip="A real trade-off; read the warnings"/>
                    <RadioButton Style="{StaticResource Chip}" Content="Experimental" GroupName="f" Tag="tier-exp" Checked="Filter_Changed" Margin="0,0,6,4"
                                 ToolTip="Boot, device or kernel-memory changes; results vary by hardware"/>
                    <RadioButton Style="{StaticResource Chip}" Content="Recommended" GroupName="f" Tag="rec" Checked="Filter_Changed" Margin="0,0,6,4"/>
                    <RadioButton Style="{StaticResource Chip}" Content="Has notes" GroupName="f" Tag="notes" Checked="Filter_Changed" Margin="0,0,6,4"
                                 ToolTip="Tweaks with known limitations, overlaps or conflicts with other tweaks"/>
                </WrapPanel>
            </DockPanel>
            <!-- All Tweaks only: one chip per category (built in code, with counts). -->
            <WrapPanel x:Name="CategoryChips" Margin="0,10,0,0" Visibility="Collapsed"/>
            <!-- Sorting: Money Tweaks' own segmented picker (built in code). -->
            <StackPanel x:Name="SortRow" Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="SORT" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Subtle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            </StackPanel>
            <DockPanel Margin="0,10,0,0">
                <TextBlock x:Name="CountText" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,12,0">
                    <Button Content="Collapse all" Style="{StaticResource GhostButton}" Padding="10,4" FontSize="11.5" Click="CollapseAll_Click" ToolTip="Fold every group to its heading"/>
                    <Button Content="Expand all" Style="{StaticResource GhostButton}" Padding="10,4" FontSize="11.5" Margin="4,0,0,0" Click="ExpandAll_Click"/>
                </StackPanel>
                <ProgressBar x:Name="ScanBar" Width="220" HorizontalAlignment="Left" Visibility="Collapsed" Maximum="1"/>
            </DockPanel>
        </StackPanel>

        <ListBox x:Name="List" Grid.Row="2" ItemTemplate="{StaticResource TweakTemplate}" Background="Transparent" Foreground="{StaticResource Text}" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel" Padding="0,0,6,20">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter x:Name="cp"/>
                                <ControlTemplate.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="cp" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22"/></Storyboard></BeginStoryboard>
                                    </EventTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Focusable" Value="False"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.GroupStyle>
                <!-- Collapsible groups: click a heading to fold its tweaks away (animated, remembered per page). -->
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="GroupItem">
                            <EventSetter Event="Loaded" Handler="Group_Loaded"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GroupItem">
                                        <StackPanel>
                                            <Button x:Name="PART_Header" Click="GroupHeader_Click" Cursor="Hand" Margin="0,8,0,8" Focusable="True"
                                                    ToolTip="Click to collapse or expand this group">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="hb" Background="Transparent" CornerRadius="0" Padding="8,7">
                                                            <Grid>
                                                                <Border x:Name="hov" Background="#0CFFFFFF" CornerRadius="0" Margin="-8,-7" Opacity="0"/>
                                                                <ContentPresenter/>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                                                                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <DockPanel LastChildFill="False">
                                                    <TextBlock x:Name="chev" Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="10" Foreground="{StaticResource Muted}"
                                                               Margin="0,0,10,0" RenderTransformOrigin="0.5,0.5" DockPanel.Dock="Left">
                                                        <TextBlock.RenderTransform><RotateTransform/></TextBlock.RenderTransform>
                                                    </TextBlock>
                                                    <Border Width="6" Height="6" CornerRadius="0" Background="{StaticResource AccentGradient}" VerticalAlignment="Center" Margin="0,0,10,0" DockPanel.Dock="Left"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource Text}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                                    <Border Style="{StaticResource Badge}" Background="#10FFFFFF" Margin="10,0,0,0" DockPanel.Dock="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ItemCount}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                                                    </Border>
                                                    <TextBlock x:Name="hint" Text="Hidden: click to show" FontSize="11" Foreground="{StaticResource Subtle}" Margin="12,0,0,0"
                                                               DockPanel.Dock="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
                                                </DockPanel>
                                            </Button>
                                            <Border x:Name="body" ClipToBounds="True">
                                                <ItemsPresenter/>
                                            </Border>
                                        </StackPanel>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </ListBox.GroupStyle>
        </ListBox>
    </Grid>
</UserControl>
