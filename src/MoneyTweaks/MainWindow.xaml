<Window x:Class="MoneyTweaks.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Money Tweaks" Width="1240" Height="800" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        Icon="Assets/MoneyTweaks.ico" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="Root" Background="{StaticResource Bg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,14,0,10">
                    <Image Source="Assets/logo.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Money Tweaks" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="Bold"/>
                        <TextBlock x:Name="VersionText" Text="v1.0.0 · free &amp; open source" Foreground="{StaticResource Muted}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Margin="12" Padding="12" CornerRadius="10" Background="{StaticResource Card}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="AdminDot" Width="8" Height="8" Fill="{StaticResource Gold}" Margin="0,0,8,0"/>
                            <TextBlock x:Name="AdminText" Text="Standard user" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="AppliedSummary" Text="Counting applied tweaks…" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,4,0,0"/>
                        <Button x:Name="ElevateButton" Content="Restart as admin" Style="{StaticResource GoldButton}" Margin="0,10,0,0" Padding="8,6" Click="Elevate_Click"/>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10,0,10,0">
                    <StackPanel x:Name="Nav">
                        <TextBlock Text="OVERVIEW" Foreground="{StaticResource Muted}" FontSize="10.5" FontWeight="Bold" Margin="12,8,0,4"/>
                        <RadioButton Style="{StaticResource NavButton}" Tag="dashboard" IsChecked="True" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="0,0,12,0"/><TextBlock Text="Dashboard" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
                        </RadioButton>
                        <TextBlock Text="TWEAKS" Foreground="{StaticResource Muted}" FontSize="10.5" FontWeight="Bold" Margin="12,14,0,4"/>
                        <StackPanel x:Name="CategoryNav"/>
                        <TextBlock Text="TOOLS" Foreground="{StaticResource Muted}" FontSize="10.5" FontWeight="Bold" Margin="12,14,0,4"/>
                        <StackPanel x:Name="ToolNav"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="Min_Click" ToolTip="Minimize"/>
                    <Button x:Name="MaxButton" Style="{StaticResource ChromeButton}" Content="&#xE922;" Click="Max_Click" ToolTip="Maximize"/>
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close"/>
                </StackPanel>
                <TextBlock x:Name="CrumbText" Text="Dashboard" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="24,0,0,0"/>
            </DockPanel>
            <StackPanel Grid.Row="1">
            <Border x:Name="UpdateBanner" Margin="24,0,24,8" Padding="14,10" CornerRadius="10" Background="{StaticResource AccentSoft}" BorderBrush="#662BE38B" BorderThickness="1" Visibility="Collapsed">
                <DockPanel>
                    <Button x:Name="UpdateButton" DockPanel.Dock="Right" Content="Update now" Style="{StaticResource PrimaryButton}" Padding="12,5" Click="Update_Click"/>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Foreground="{StaticResource Accent}" Margin="0,0,10,0"/>
                    <TextBlock x:Name="UpdateText" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12.5"/>
                </DockPanel>
            </Border>
            <Border x:Name="AdminBanner" Margin="24,0,24,8" Padding="14,10" CornerRadius="10" Background="{StaticResource GoldSoft}" BorderBrush="#66F5C451" BorderThickness="1">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Restart as admin" Style="{StaticResource GoldButton}" Padding="12,5" Click="Elevate_Click"/>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource Gold}" Margin="0,0,10,0"/>
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12.5"
                               Text="Running without administrator rights. You can browse everything and change per-user tweaks; system-wide tweaks will ask you to restart as admin."/>
                </DockPanel>
            </Border>
            </StackPanel>
            <ContentControl x:Name="Host" Grid.Row="2" Focusable="False"/>
            <Border x:Name="Toast" Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,22" Padding="16,10"
                    CornerRadius="10" Background="{StaticResource Surface}" BorderBrush="{StaticResource Accent}" BorderThickness="1" Opacity="0" IsHitTestVisible="False">
                <TextBlock x:Name="ToastText" FontSize="13"/>
            </Border>
        </Grid>
    </Grid>
</Window>
