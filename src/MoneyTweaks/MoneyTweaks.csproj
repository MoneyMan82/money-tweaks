<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(WindowsTargetFramework)</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the background-mode tray icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>MoneyTweaks</RootNamespace>
    <AssemblyName>MoneyTweaks</AssemblyName>
    <ApplicationIcon>Assets\MoneyTweaks.ico</ApplicationIcon>
    <!-- No package XML docs (WebView2) next to the published exe. -->
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep WPF types unambiguous: Windows Forms is used only through an alias in TrayIcon.cs. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MoneyTweaks.Core\MoneyTweaks.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\MoneyTweaks.ico" />
  </ItemGroup>
  <ItemGroup>
    <!-- Legacy UI recolours a copy of the theme's source before the first window opens. -->
    <EmbeddedResource Include="Themes\Theme.xaml" LogicalName="MoneyTweaks.Themes.Theme.xaml" />
    <!-- Third-party license notices, shown in Settings & About so even the single-file .exe carries them. -->
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.md" LogicalName="MoneyTweaks.THIRD-PARTY-NOTICES.md" />
    <!-- Verified third-party GPU models and their license manifest (Reality Lab). -->
    <EmbeddedResource Include="Assets\Gpu\*.glb;Assets\Gpu\manifest.json" LogicalName="MoneyTweaks.Gpu.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>
</Project>
