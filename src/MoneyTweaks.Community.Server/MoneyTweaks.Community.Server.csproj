<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Money Tweaks Community Hub API. Cross-platform ASP.NET Core service: SQLite for data, an object store (S3-compatible such
    as Cloudflare R2, or a persistent folder) for images, GitHub sign-in for identity. Not deployed anywhere by this repo.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <SupportedOSPlatformVersion></SupportedOSPlatformVersion>
    <RootNamespace>MoneyTweaks.Community.Server</RootNamespace>
    <DefineConstants>$(DefineConstants);MT_COMMUNITY_SERVER</DefineConstants>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MoneyTweaks.Community.Shared\MoneyTweaks.Community.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The app's own crosshair rules, so the server validates and renders crosshairs exactly like the app. -->
    <Compile Include="..\MoneyTweaks.Core\Crosshair\CrosshairModel.cs" Link="Crosshair\CrosshairModel.cs" />
    <Compile Include="..\MoneyTweaks.Core\Crosshair\CrosshairGeometry.cs" Link="Crosshair\CrosshairGeometry.cs" />
    <Compile Include="..\MoneyTweaks.Core\Crosshair\CrosshairSanitizer.cs" Link="Crosshair\CrosshairSanitizer.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MoneyTweaks.Community.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!--
      ImageSharp 3.1.12 is the last 3.x release; the first patched version (4.1.2) requires a Six Labors license key to build.
      These advisories only affect HistogramEqualization and the TIFF CCITT T4/T6 encoders. The Community server never uses
      HistogramEqualization or the TIFF encoder (it only resizes, draws, and encodes PNG/JPEG), so they are suppressed by id.
    -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
  </ItemGroup>
</Project>
