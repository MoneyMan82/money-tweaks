<Application x:Class="MoneyTweaks.AgentCenter.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#07090D"/>
    <SolidColorBrush x:Key="Panel" Color="#0D1117"/>
    <SolidColorBrush x:Key="Panel2" Color="#121821"/>
    <SolidColorBrush x:Key="Line" Color="#1D2733"/>
    <SolidColorBrush x:Key="LineBright" Color="#2C3B4C"/>
    <SolidColorBrush x:Key="Fg" Color="#D9E3EC"/>
    <SolidColorBrush x:Key="Dim" Color="#7C8A98"/>
    <SolidColorBrush x:Key="Accent" Color="#00E1FF"/>
    <SolidColorBrush x:Key="Violet" Color="#8B6CFF"/>
    <FontFamily x:Key="Display">Bahnschrift, Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Body">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>

    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="#121821"/>
      <Setter Property="Foreground" Value="#D9E3EC"/>
      <Setter Property="BorderBrush" Value="#2C3B4C"/>
      <Setter Property="FontFamily" Value="{StaticResource Body}"/>
      <Setter Property="MaxWidth" Value="460"/>
      <Setter Property="ContentTemplate">
        <Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></Setter.Value>
      </Setter>
    </Style>

    <!-- Angular button: no rounded corners, cut top-right corner, accent edge on hover. -->
    <Style x:Key="CmdButton" TargetType="Button">
      <Setter Property="Foreground" Value="#D9E3EC"/>
      <Setter Property="Background" Value="#121821"/>
      <Setter Property="BorderBrush" Value="#2C3B4C"/>
      <Setter Property="FontFamily" Value="{StaticResource Display}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Margin" Value="4,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Path x:Name="Shape" Stretch="Fill" Data="M0,0 L92,0 100,8 100,100 0,100 Z" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1"/>
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shape" Property="Stroke" Value="#00E1FF"/><Setter TargetName="Shape" Property="Fill" Value="#16212D"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shape" Property="Stroke" Value="#00E1FF"/><Setter TargetName="Shape" Property="StrokeThickness" Value="2"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shape" Property="Fill" Value="#0B2A33"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Tab-like toggle for the main views. -->
    <Style x:Key="NavTab" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#7C8A98"/>
      <Setter Property="FontFamily" Value="{StaticResource Display}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Background="Transparent" Margin="0,0,18,0">
              <ContentPresenter Margin="2,8,2,10"/>
              <Rectangle x:Name="Bar" Height="2" VerticalAlignment="Bottom" Fill="#00E1FF" Opacity="0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="#FFFFFF"/><Setter TargetName="Bar" Property="Opacity" Value="1"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#D9E3EC"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bar" Property="Opacity" Value="0.6"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0A0E13"/>
      <Setter Property="Foreground" Value="#D9E3EC"/>
      <Setter Property="BorderBrush" Value="#2C3B4C"/>
      <Setter Property="CaretBrush" Value="#00E1FF"/>
      <Setter Property="SelectionBrush" Value="#00E1FF"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="FontFamily" Value="{StaticResource Body}"/>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="FontFamily" Value="{StaticResource Body}"/>
    </Style>

    <Style TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="B" Background="Transparent" BorderThickness="2,0,0,0" BorderBrush="Transparent"><ContentPresenter/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#101821"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="B" Property="Background" Value="#0F202A"/><Setter TargetName="B" Property="BorderBrush" Value="#00E1FF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Slim angular scrollbars. -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/>
      <Setter Property="MinWidth" Value="8"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template><ControlTemplate TargetType="Thumb"><Rectangle Fill="#2C3B4C" Margin="2,0"/></ControlTemplate></Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Height" Value="8"/>
          <Setter Property="MinHeight" Value="8"/>
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track">
                  <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Rectangle Fill="#2C3B4C" Margin="0,2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                </Track>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="GridSplitter">
      <Setter Property="Background" Value="#1D2733"/>
      <Setter Property="Focusable" Value="False"/>
    </Style>

    <Style TargetType="Slider">
      <Setter Property="Foreground" Value="#00E1FF"/>
    </Style>
  </Application.Resources>
</Application>
