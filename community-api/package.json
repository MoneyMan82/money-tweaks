{
  "name": "money-tweaks-community-api",
  "private": true,
  "description": "Money Tweaks Community Hub API: a separate Cloudflare Worker (D1, R2, Images).",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "test": "vitest run",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit && vitest run && wrangler deploy --dry-run --outdir .wrangler/dry",
    "typecheck": "tsc --noEmit",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20261006.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.148.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261006.1": true
  }
}
